<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:eThangAgent.Desktop.Markdown"
             xmlns:vm="using:eThangAgent.Desktop.ViewModels"
             x:Class="eThangAgent.Desktop.Views.AgentView"
             x:DataType="vm:AgentSessionViewModel">
  <UserControl.Styles>
    <!-- Keyboard highlight for the clarify option the arrow keys rest on. -->
    <Style Selector="Button.selected">
      <Setter Property="BorderBrush" Value="#4C8CFF"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Status bar: phase first, then context, the running tool's elapsed,
         provider, model id, reasoning effort. -->
    <Border DockPanel.Dock="Bottom" Background="#22000000">
      <StackPanel x:Name="StatusBar" Orientation="Horizontal" Spacing="12" Margin="8,4">
        <TextBlock x:Name="SpinnerText" Text="{Binding Status.Spinner}"/>
        <TextBlock x:Name="PhaseText" Text="{Binding Status.PhaseLabel}"/>
        <TextBlock x:Name="ContextText" Text="{Binding Status.ContextDisplay}" ToolTip.Tip="{Binding Status.ContextBreakdownText}"/>
        <TextBlock x:Name="ToolText" Text="{Binding Status.ToolDisplay}"/>
        <TextBlock Text="{Binding Status.Provider}"/>
        <TextBlock Text="{Binding Status.ModelId}"/>
        <TextBlock Text="{Binding Status.Effort, StringFormat='effort: {0}'}"/>
        <Button x:Name="SessionIdButton" Content="Sess. Id ⧉" Padding="6,0"
                Click="OnCopySessionId" VerticalAlignment="Center"
                ToolTip.Tip="{Binding SessionIdFull}"/>
      </StackPanel>
    </Border>

    <!-- Input area OR clarify mode. -->
    <DockPanel DockPanel.Dock="Bottom">
      <!-- Clarify mode: replaces the input row while a question is pending. -->
      <StackPanel x:Name="ClarifyArea" DockPanel.Dock="Bottom" Focusable="True"
                  KeyDown="OnClarifyAreaKeyDown"
                  IsVisible="{Binding Clarify, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
          <TextBlock Text="{Binding Clarify.Question}" TextWrapping="Wrap" MaxWidth="640"/>
          <TextBlock Text="{Binding Clarify.ProgressLabel}" Foreground="Gray"
                     IsVisible="{Binding Clarify.ProgressLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        <TextBlock Text="{Binding Clarify.ValidationMessage}" Foreground="OrangeRed" Margin="8,0"
                   TextWrapping="Wrap"
                   IsVisible="{Binding Clarify.ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <ItemsControl ItemsSource="{Binding Clarify.OptionRows}" Margin="8,2">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClarifyOptionRow">
              <Button Classes.selected="{Binding IsSelected}" Click="OnClarifyOption" Margin="2"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Margin="0,0,6,0">
                    <Run Text="{Binding Index, Mode=OneWay}"/><Run Text="."/>
                  </TextBlock>
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4"
                    IsVisible="{Binding Clarify.AllowFreeText}">
          <TextBox x:Name="ClarifyInput" Text="{Binding Clarify.Input}" Width="480"
                   KeyDown="OnClarifyInputKeyDown"/>
          <Button Content="Answer" Click="OnClarifyAnswer"/>
          <Button Content="Cancel" Click="OnClarifyCancel"/>
        </StackPanel>
      </StackPanel>

      <!-- Normal input row. The input stays enabled while a turn runs: text submitted
           then steers the active turn; the Stop button interrupts it. -->
      <StackPanel x:Name="InputArea" DockPanel.Dock="Bottom">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="InputBox" Width="480" PlaceholderText="Type a message"
                   AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/>
          <Button x:Name="StopButton" Content="Stop"
                  IsVisible="{Binding IsBusy}" Click="OnStopClick" VerticalAlignment="Top"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Transcript: one implicit template per entry type. ScrollChanged feeds the
         sticky auto-scroll controller (see AgentView code-behind). -->
    <ScrollViewer x:Name="TranscriptScroll" ScrollChanged="OnTranscriptScrollChanged">
      <ItemsControl x:Name="TranscriptList" ItemsSource="{Binding Transcript.Entries}" Margin="4,8">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:UserMessageEntry">
            <SelectableTextBlock Text="{Binding Text}" FontWeight="Bold" Margin="8,2" TextWrapping="Wrap"/>
          </DataTemplate>
          <DataTemplate DataType="vm:AssistantTextEntry">
            <md:AssistantMarkdownBlock MarkdownText="{Binding Text}" IsOpen="{Binding IsOpen}" Margin="8,2" TextWrapping="Wrap"/>
          </DataTemplate>
          <DataTemplate DataType="vm:ReasoningEntry">
            <md:ReasoningMarkdownBlock MarkdownText="{Binding Text}" IsOpen="{Binding IsOpen}" Margin="8,2" TextWrapping="Wrap"/>
          </DataTemplate>
          <DataTemplate DataType="vm:ToolCallEntry">
            <Expander Margin="8,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <Expander.Header>
                <TextBlock TextWrapping="Wrap" MaxWidth="620">
                  <Run Text="⚙ "/><Run Text="{Binding Name, Mode=OneWay}"/>
                  <Run Foreground="Gray" Text="{Binding Preview, Mode=OneWay}"/>
                </TextBlock>
              </Expander.Header>
              <SelectableTextBlock FontFamily="Consolas, Courier New" TextWrapping="Wrap" FontSize="12"
                                   Text="{Binding ArgumentsFormatted, Mode=OneWay}"/>
            </Expander>
          </DataTemplate>
          <DataTemplate DataType="vm:ToolResultEntry">
            <Expander Margin="8,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <Expander.Header>
                <TextBlock TextWrapping="Wrap" MaxWidth="620">
                  <Run Text="↳ "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" "/>
                  <Run Text="{Binding Summary, Mode=OneWay}"
                       Foreground="{Binding SummaryBrush, Mode=OneWay}"/>
                </TextBlock>
              </Expander.Header>
              <SelectableTextBlock FontFamily="Consolas, Courier New" TextWrapping="Wrap" FontSize="12"
                                   Text="{Binding FullContent, Mode=OneWay}"/>
            </Expander>
          </DataTemplate>
          <DataTemplate DataType="vm:NoticeEntry">
            <SelectableTextBlock Text="{Binding Text}" Foreground="DarkGray" Margin="8,2" TextWrapping="Wrap"/>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
