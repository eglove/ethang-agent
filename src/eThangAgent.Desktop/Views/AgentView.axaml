<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="using:eThangAgent.Desktop.Markdown"
             xmlns:vm="using:eThangAgent.Desktop.ViewModels"
             x:Class="eThangAgent.Desktop.Views.AgentView"
             x:DataType="vm:AgentSessionViewModel">
  <UserControl.Styles>
    <!-- Stop glyph must sit centered in its button regardless of template
         defaults: target the presenter directly (same as the rail menu items). -->
    <Style Selector="Button#StopButton > ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Header label inset must mirror the chevron's right inset: stretch the
         header AND its presenter content, so the header DockPanel spans the full
         row - the fill label starts at the symmetric 8 DIP padding (mirroring the
         chevron inset) and the docked-right elapsed counter ends flush against
         the chevron instead of hugging the label text. -->
    <Style Selector="Expander.tool-card /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Padding" Value="8,8,8,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Expander.tool-card /template/ ToggleButton#ExpanderHeader ContentPresenter">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Keyboard highlight for a focused option button. -->
    <Style Selector="Button.selected">
      <Setter Property="BorderBrush" Value="#4C8CFF"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Command mode: input text starts with '!' — the border turns amber so the
         user sees, before pressing Enter, that the line runs as a shell command
         instead of going to the model. The class is toggled by the view's
         TextChanged handler; this style is what makes it visible. The selector
         targets the TEMPLATE's border element directly: Fluent's :focus/:pointerover
         theme styles set PART_BorderElement's brush themselves, and a control-level
         BorderBrush (TemplateBinding) loses to them exactly while the user is typing.
         A host-style scope outranks the theme scope, so this wins under focus too. -->
    <Style Selector="TextBox.command /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#FFB454"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- Status bar: phase first, then context, provider, model id, reasoning effort.
         The running tool's elapsed lives in its chat tool cards, not here. -->
    <Border DockPanel.Dock="Bottom" Background="#22000000">
      <DockPanel x:Name="StatusBar" Margin="8,4" LastChildFill="False">
        <Button x:Name="SessionIdButton" DockPanel.Dock="Right" Content="Sess. Id ⧉" Padding="6,0"
                Click="OnCopySessionId" VerticalAlignment="Center"
                ToolTip.Tip="{Binding SessionIdFull}"/>
        <StackPanel x:Name="StatusInfo" Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="SpinnerText" Text="{Binding Status.Spinner}"/>
          <TextBlock x:Name="PhaseText" Text="{Binding Status.PhaseLabel}"/>
          <TextBlock x:Name="ContextText" Text="{Binding Status.ContextDisplay}" ToolTip.Tip="{Binding Status.ContextBreakdownText}"/>
          <TextBlock Text="{Binding Status.Provider}"/>
          <TextBlock Text="{Binding Status.ModelId}"/>
          <TextBlock Text="{Binding Status.Effort, StringFormat='effort: {0}'}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Input area. -->
    <DockPanel DockPanel.Dock="Bottom">
      <!-- Normal input row. The input stays enabled while a turn runs: text submitted
           then steers the active turn; the Stop button interrupts it. -->
      <StackPanel x:Name="InputArea" DockPanel.Dock="Bottom">
        <Grid ColumnDefinitions="*,Auto" Margin="8,0">
          <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="Type a message"
                   AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"/>
          <Button x:Name="StopButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="36" Padding="10,0"
                  IsVisible="{Binding IsBusy}" Click="OnStopClick" VerticalAlignment="Stretch"
                  Content="■" FontSize="14" ToolTip.Tip="Stop"/>
        </Grid>
      </StackPanel>
    </DockPanel>

    <!-- Transcript: one implicit template per entry type. ScrollChanged feeds the
         sticky auto-scroll controller (see AgentView code-behind). -->
    <ScrollViewer x:Name="TranscriptScroll" ScrollChanged="OnTranscriptScrollChanged">
      <ItemsControl x:Name="TranscriptList" ItemsSource="{Binding Transcript.Entries}" Margin="4,8">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:UserMessageEntry">
            <SelectableTextBlock Text="{Binding Text}" FontWeight="Bold" Margin="8,2" TextWrapping="Wrap"/>
          </DataTemplate>
          <DataTemplate DataType="vm:AssistantTextEntry">
            <md:AgentMarkdownBlock MarkdownText="{Binding Text}" IsOpen="{Binding IsOpen}" Margin="8,2"/>
          </DataTemplate>
          <DataTemplate DataType="vm:ReasoningEntry">
            <md:AgentMarkdownBlock MarkdownText="{Binding Text}" IsOpen="{Binding IsOpen}" Variant="Reasoning" Margin="8,2"/>
          </DataTemplate>
          <DataTemplate DataType="vm:ToolCallEntry">
            <Expander Classes="tool-card" Margin="8,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <Expander.Header>
                <DockPanel HorizontalAlignment="Stretch">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <!-- Live count-up: bound through the INPC handle leaf so the tick's
                         PropertyChanged reaches this TextBlock directly, never rebuilding
                         the entry (the chevron re-animation fix). Visible only while a
                         tool runs; restored cards show the budget alone. -->
                    <TextBlock IsVisible="{Binding HasLiveElapsed}"
                               Text="{Binding Elapsed.Display, Mode=OneWay}"/>
                    <TextBlock IsVisible="{Binding ShowTimeSeparator}" Text=" / " Foreground="Gray"/>
                    <TextBlock Text="{Binding BudgetDisplay, Mode=OneWay}" Foreground="Gray"/>
                  </StackPanel>
                  <Panel>
                    <!-- Exec call: the card IS the program - title-only header. -->
                    <TextBlock IsVisible="{Binding IsExecCall}" TextWrapping="Wrap">
                      <Run Text="⚙ "/><Run Text="{Binding HeaderTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <!-- Every other tool keeps the name + args preview header. -->
                    <TextBlock IsVisible="{Binding !IsExecCall}" TextWrapping="Wrap">
                      <Run Text="⚙ "/><Run Text="{Binding Name, Mode=OneWay}"/>
                      <Run Foreground="Gray" Text="{Binding Preview, Mode=OneWay}"/>
                    </TextBlock>
                  </Panel>
                </DockPanel>
              </Expander.Header>
              <Panel>
                <!-- Exec call body: ONLY the program, fenced for the markdown renderer. -->
                <md:AgentMarkdownBlock IsVisible="{Binding IsExecCall}" MarkdownText="{Binding ProgramBody, Mode=OneWay}"/>
                <SelectableTextBlock IsVisible="{Binding !IsExecCall}" FontFamily="Consolas, Courier New" TextWrapping="Wrap" FontSize="12"
                                     Text="{Binding ArgumentsFormatted, Mode=OneWay}"/>
              </Panel>
            </Expander>
          </DataTemplate>
          <DataTemplate DataType="vm:ToolResultEntry">
            <Expander Classes="tool-card" Margin="8,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <Expander.Header>
                <DockPanel HorizontalAlignment="Stretch">
                  <TextBlock DockPanel.Dock="Right" Foreground="Gray" Margin="8,0,0,0"
                             Text="{Binding ElapsedDisplay, Mode=OneWay}"/>
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="↳ "/><Run Text="{Binding Name, Mode=OneWay}"/>
                    <Run Text="{Binding HeaderTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=" "/><Run Text=" "/>
                    <Run Text="{Binding Summary, Mode=OneWay}"
                         Foreground="{Binding SummaryBrush, Mode=OneWay}"/>
                  </TextBlock>
                </DockPanel>
              </Expander.Header>
            <SelectableTextBlock FontFamily="Consolas, Courier New" TextWrapping="Wrap" FontSize="12"
                                   Text="{Binding FullContent, Mode=OneWay}"/>
            </Expander>
          </DataTemplate>
          <DataTemplate DataType="vm:CommandRunEntry">
            <SelectableTextBlock Margin="8,2" TextWrapping="Wrap">
              <Run Text="! "/><Run Text="{Binding Command}"/>
            </SelectableTextBlock>
          </DataTemplate>
          <DataTemplate DataType="vm:CommandResultEntry">
            <Expander Classes="tool-card" Margin="8,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <Expander.Header>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="↳ "/><Run Text="{Binding Command}"/><Run Text="  "/>
                  <Run Text="{Binding StatusLine, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}"/>
                </TextBlock>
              </Expander.Header>
              <SelectableTextBlock FontFamily="Consolas, Courier New" TextWrapping="Wrap" FontSize="12"
                                   Text="{Binding OutputDisplay}"/>
            </Expander>
          </DataTemplate>
          <DataTemplate DataType="vm:NoticeEntry">
            <SelectableTextBlock Text="{Binding Text}" Foreground="DarkGray" Margin="8,2" TextWrapping="Wrap"/>
          </DataTemplate>
          <DataTemplate DataType="vm:BootstrapEntry">
            <Grid Margin="8,2">
              <!-- Collapsed by default: the header line reads exactly as before;
                   expanding reveals the verbatim system prompt - nothing hidden. -->
              <Expander IsExpanded="False"
                        IsVisible="{Binding HasSystemPrompt}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <Expander.Header>
                  <SelectableTextBlock Text="{Binding Summary}" Foreground="#6E7B91" TextWrapping="Wrap"/>
                </Expander.Header>
                <SelectableTextBlock FontFamily="Consolas, Courier New" FontSize="12" Foreground="#6E7B91"
                                     Text="{Binding SystemPrompt}" TextWrapping="Wrap"/>
              </Expander>
            </Grid>
          </DataTemplate>
          <DataTemplate DataType="vm:SystemMessageEntry">
            <Grid ColumnDefinitions="Auto,*" Margin="8,2">
              <TextBlock Grid.Column="0" Foreground="#9EB8D9" Text="❖ " VerticalAlignment="Top"/>
              <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#B9C7E2" TextWrapping="Wrap"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
