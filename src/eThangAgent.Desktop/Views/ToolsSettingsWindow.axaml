<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.ToolsSettingsWindow"
        x:DataType="vm:ToolsSettingsViewModel"
        Title="Tools - which command-line tools agents are told about"
        Width="820" Height="640" MinWidth="620" MinHeight="420"
        CanResize="True" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8">
      Every console program and script on this machine's PATH is listed here, grouped by the
      directory it lives in. Ticked tools are named to every agent this app opens, so an agent
      knows which commands exist. A ticked tool that is not on the PATH is kept and shown as
      unavailable, and it is left out of what agents are told.
    </TextBlock>

    <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" x:Name="SearchBox" Text="{Binding SearchText}"
                 PlaceholderText="Filter by name"/>
        <Button Grid.Column="1" x:Name="SaveButton" Content="Save"
                Command="{Binding SaveCommand}"/>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0" x:Name="AddNameBox" Text="{Binding NameToAdd}"
                 PlaceholderText="Add a tool name that is not on the PATH"/>
        <Button Grid.Column="1" x:Name="AddNameButton" Content="Add"
                Command="{Binding AddNameCommand}"/>
      </Grid>
      <TextBlock x:Name="SummaryText" Text="{Binding SummaryText}" FontWeight="SemiBold"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolGroupViewModel">
            <Border BorderBrush="#33808080" BorderThickness="0,0,0,1" Padding="0,6">
              <StackPanel Spacing="4">
                <Expander IsExpanded="{Binding IsExpanded}">
                  <Expander.Header>
                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ToolRowViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsTicked}"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AvailabilityText}" FontSize="12"
                                       Opacity="0.6" VerticalAlignment="Center"
                                       IsVisible="{Binding IsUnavailable}"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
      <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Opacity="0.7"
                 TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="RefreshButton" Content="Rescan" Command="{Binding LoadCommand}"/>
        <Button x:Name="CloseButton" Content="Close" Click="OnClose"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
