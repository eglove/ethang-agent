<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="using:eThangAgent.ModelDomain"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.ModelSettingsWindow"
        x:DataType="vm:ModelSettingsViewModel"
        Title="Model Settings" Width="520" Height="680" MinWidth="460" MinHeight="420"
        CanResize="True" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <!-- Shared footer: validation error plus Save/Cancel, outside the scroll so it
         applies to whichever section is showing. -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
      <TextBlock Text="{Binding ValidationError}" Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel"/>
        <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <!-- 8 DIP right inset reserves the overlay-scrollbar strip: inputs never sit under the thumb. -->
      <StackPanel Spacing="12" Margin="0,0,8,0">
        <!-- Model + provider choice (issue #296, D1): TWO levels, not one flat list.
             The model level summarises each model by its best provider under the current
             preset; the provider level shows every endpoint of the selected model with its
             own evidence. The old surface deduped 35 provider rows into one model row and
             priced it by whichever endpoint sorted first — for deepseek-v4.1-flash that was
             the single worst cache ratio on the model. -->
        <StackPanel Spacing="4">
          <TextBlock Text="Model" FontWeight="SemiBold"/>
          <TextBox PlaceholderText="Search models…" Text="{Binding ModelSection.SearchText}"/>
          <Panel MinHeight="120">
            <ListBox x:Name="ModelList" ItemsSource="{Binding ModelSection.FilteredRows}"
                     SelectedItem="{Binding ModelSection.SelectedRow}" MaxHeight="180">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelPickerRow">
                  <StackPanel Margin="2,4">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Loading model catalog…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.7" IsVisible="{Binding ModelSection.IsLoading}"/>
          </Panel>
          <TextBlock Text="{Binding ModelSection.LoadError}" Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"
                     IsVisible="{Binding ModelSection.LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- The routing VARIANT: the whole second half of the model decision. OpenRouter
             expresses 'fastest' and 'cheapest' as suffixes on the model id, so this one
             dropdown replaces the retired provider/endpoint level and its ordering presets.
             The rows are the BARE NAMES; the caption underneath states what each one trades,
             so the explanation lives in exactly one place. -->
        <StackPanel Spacing="4">
          <TextBlock Text="Routing" FontWeight="SemiBold"/>
          <ComboBox x:Name="VariantBox" ItemsSource="{Binding ModelSection.VariantOptions}"
                    SelectedItem="{Binding ModelSection.SelectedVariantOption}"
                    DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch"/>
          <TextBlock Text="{Binding ModelSection.VariantCaption}" FontSize="11" Opacity="0.6"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Reasoning effort: the same vocabulary the old effort picker offered. -->
        <StackPanel Spacing="4">
          <TextBlock Text="Reasoning effort" FontWeight="SemiBold"/>
          <ComboBox x:Name="EffortBox" ItemsSource="{Binding EffortOptions}"
                    SelectedItem="{Binding SelectedEffortOption}"
                    DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Reasoning summary (display channel only): asks the provider for its own
             summary of its reasoning instead of the raw trace. Independent of the
             effort knob — either can be set alone. OpenRouter-only: the key rides
             the OpenRouter request's reasoning object. -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowOpenRouterSection}">
          <TextBlock Text="Reasoning summary (display)" FontWeight="SemiBold"/>
          <ComboBox x:Name="SummaryBox" ItemsSource="{Binding SummaryOptions}"
                    SelectedItem="{Binding SelectedSummaryOption}"
                    DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch"/>
          <TextBlock Text="What the provider streams into the transcript. Never enters the request's context."
                     FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- The twelve sampling knobs. Fixed-vocabulary knobs (verbosity,
              parallel tool calls) render as dropdowns over their documented
              values; free-range knobs keep the text box. -->
        <TextBlock Text="Sampling" FontWeight="SemiBold"/>
        <ItemsControl x:Name="KnobList" ItemsSource="{Binding KnobRows}" Margin="0,-8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KnobRow">
              <StackPanel Spacing="2" Margin="0,4">
                <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.75"/>
                <Panel>
                  <TextBox Text="{Binding Text}" IsEnabled="{Binding IsEnabled}"
                           IsVisible="{Binding !HasChoices}"/>
                  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                            DisplayMemberBinding="{Binding Display}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsEnabled}" IsVisible="{Binding HasChoices}"/>
                </Panel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- OpenRouter-only: server tools, plugins, budgets. Collapsed
             entirely on non-OpenRouter sessions; a save then persists null. -->
        <StackPanel IsVisible="{Binding ShowOpenRouterSection}" Spacing="8">
          <TextBlock Text="Server-side tools" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <ItemsControl ItemsSource="{Binding ToolToggles}" Margin="0,-8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolToggleRow">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Spacing="4">
            <TextBlock Text="Max tool calls (empty = unbounded)" FontSize="12" Opacity="0.75"/>
            <TextBox Text="{Binding ServerTools.MaxToolCallsText}"/>
            <TextBlock Text="Stop server tools when (comma-separated)" FontSize="12" Opacity="0.75"/>
            <TextBox Text="{Binding ServerTools.StopServerToolsWhenText}"/>
          </StackPanel>

          <TextBlock Text="Plugins" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <CheckBox Content="Web grounding" IsChecked="{Binding Plugins.WebGrounding}"/>
          <TextBlock Text="Search engine" FontSize="12" Opacity="0.75"/>
          <ComboBox ItemsSource="{Binding Plugins.EngineChoices}" SelectedItem="{Binding Plugins.SelectedEngine}"
                    DisplayMemberBinding="{Binding Display}" HorizontalAlignment="Stretch"/>
          <CheckBox Content="Response healing" IsChecked="{Binding Plugins.ResponseHealing}"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
