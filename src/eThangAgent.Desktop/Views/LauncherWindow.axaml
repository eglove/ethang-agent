<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.LauncherWindow"
        x:DataType="vm:LauncherViewModel"
        Title="eThang Agent" Width="720" Height="480" MinWidth="560" MinHeight="380"
        CanResize="True" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20">

    <!-- The wordmark and the one thing the launcher must say when it cannot do anything:
         no provider key is configured yet. -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="eThang Agent" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Choose a workspace to open." Opacity="0.7" FontSize="13"/>
      <Border Padding="8,4" Background="#FF5A2A2A" CornerRadius="3"
              IsVisible="{Binding !HasConfiguredProvider}">
        <TextBlock Text="No API key configured yet — open Settings to add one."
                   FontSize="12" Foreground="#FFFFD9D9" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <Panel Grid.Row="1">
      <ListBox x:Name="RecentList" ItemsSource="{Binding Recents}"
               DoubleTapped="OnRecentDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RecentWorkspaceRow">
            <Grid ColumnDefinitions="*,Auto" Margin="2,4" Opacity="{Binding Dimming}"
                  ToolTip.Tip="{Binding ToolTip}">
              <StackPanel Grid.Column="0">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                <TextBlock FontSize="12" Opacity="0.6" Text="{Binding Detail}"/>
              </StackPanel>
              <Button Grid.Column="1" Content="✕" Padding="6,0" Background="Transparent"
                      BorderThickness="0" VerticalAlignment="Center"
                      ToolTip.Tip="Remove from this list"
                      Command="{Binding $parent[ListBox].((vm:LauncherViewModel)DataContext).ForgetCommand}"
                      CommandParameter="{Binding}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="Loading recent workspaces…" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Opacity="0.7" IsVisible="{Binding IsLoading}"/>
      <TextBlock Text="No recent workspaces yet — open a folder to begin."
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
                 IsHitTestVisible="False" IsVisible="{Binding ShowEmptyState}"/>
    </Panel>

    <TextBlock Grid.Row="2" Text="{Binding LoadError}" Foreground="OrangeRed"
               TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
               IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button x:Name="SettingsButton" Content="Settings" Command="{Binding SettingsCommand}"/>
      <Button x:Name="OpenFolderButton" Content="Open Folder…"
              Command="{Binding OpenFolderCommand}"/>
    </StackPanel>
  </Grid>
</Window>
