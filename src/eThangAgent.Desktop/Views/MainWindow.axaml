<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:eThangAgent.Desktop.Views"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="eThang Agent" Width="1000" Height="700"
        WindowState="Maximized" Closing="OnWindowClosing">
  <Window.Styles>
    <!-- Icon glyphs must sit centered in their buttons regardless of template
         defaults: target the presenter directly. -->
    <Style Selector="Button.menu-item > ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="Auto,*">

    <!-- Left-hand icon rail: one icon per entry, the label lives in the hover
         tooltip; settings anchored at the bottom. No fill child: every button is
         docked explicitly. -->
    <Border Grid.Column="0" x:Name="SideMenu" Background="#FF1B1B2F" Width="48">
      <DockPanel LastChildFill="False">
        <Button x:Name="OpenAgentMenuItem" Classes="menu-item" DockPanel.Dock="Top" Content="📂"
                Width="40" Height="34" Padding="0" FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,8,0,2" Command="{Binding OpenAgentCommand}"
                ToolTip.Tip="Open Workspace"/>
        <Button x:Name="SessionsMenuItem" Classes="menu-item" DockPanel.Dock="Top" Content="💬"
                Width="40" Height="34" Padding="0" FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,2" Command="{Binding OpenSessionsCommand}"
                ToolTip.Tip="Sessions — resume a previous session"/>
        <Button x:Name="ModelSettingsMenuItem" Classes="menu-item" DockPanel.Dock="Top" Content="🎛"
                Width="40" Height="34" Padding="0" FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,2" Command="{Binding ChooseModelSettingsCommand}"
                IsVisible="{Binding HasSelectedTab}"
                ToolTip.Tip="Model Settings — model, effort, sampling knobs, and provider routing"/>
        <Button x:Name="McpServersMenuItem" Classes="menu-item" DockPanel.Dock="Top" Content="🔌"
                Width="40" Height="34" Padding="0" FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,2" Command="{Binding OpenMcpServersCommand}"
                IsVisible="{Binding HasSelectedTab}"
                ToolTip.Tip="MCP Servers — configured servers and their live state"/>
        <Button x:Name="SettingsMenuItem" Classes="menu-item" DockPanel.Dock="Bottom" Content="⚙"
                Width="40" Height="34" Padding="0" FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,2,0,8" Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Settings"/>
      </DockPanel>
    </Border>

    <!-- Tab host: a header strip (the TabControl renders headers only) over a
         keep-alive content panel — one AgentView per open tab, built at open and
         retained across selection changes (grand-plan BUG 2). IsSelected toggles
         visibility: switches are visibility flips, no transcript re-render storm,
         and each view's spinner/elapsed timers keep running for background tabs. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

      <!-- Resource indicator (spec D14): app-wide, because the budget is app-wide.
           READ-ONLY - it reports what IS, and offers no action on the governor.
           The details toggle reveals the consumers and the decisions inline, in the
           same bar: a full panel would be more chrome than the data deserves. -->
      <Border x:Name="ResourceBar" Grid.Row="0" Padding="10,5"
              Background="#FF23232E">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Memory" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ResourceUsageText" Text="{Binding Resource.UsageDisplay}"
                       FontSize="12" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ResourceUsageBar" Width="140" Height="6"
                         Minimum="0" Maximum="1" Value="{Binding Resource.UsageFraction}"
                         VerticalAlignment="Center"/>
            <TextBlock x:Name="ResourceLevelText" Text="{Binding Resource.LevelDisplay}"
                       FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="ResourceLevelBasisText" Text="{Binding Resource.LevelBasisDisplay}"
                       FontSize="11" Opacity="0.8" VerticalAlignment="Center"/>
            <Button x:Name="ResourceDetailsButton" Content="Details" Padding="6,1"
                    FontSize="11" Command="{Binding ToggleResourceDetailsCommand}"
                    ToolTip.Tip="Show the memory consumers and the governor's decisions"/>
          </StackPanel>

          <!-- The details: the largest consumers and the governor's audit trail. -->
          <StackPanel x:Name="ResourceDetailsPanel" Spacing="4"
                      IsVisible="{Binding IsResourceDetailsOpen}">
            <TextBlock Text="Largest consumers" FontWeight="SemiBold" FontSize="11"/>
            <TextBlock x:Name="ResourceAppUsageText" Text="{Binding Resource.AppUsageDisplay}"
                       FontSize="11" Opacity="0.85"/>
            <ItemsControl x:Name="ResourceConsumersList" ItemsSource="{Binding Resource.Consumers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="11" Opacity="0.85" Text="{Binding Text}"
                             TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Decisions" FontWeight="SemiBold" FontSize="11"/>
            <ItemsControl x:Name="ResourceDecisionsList" ItemsSource="{Binding Resource.RecentDecisions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontSize="11" Opacity="0.85" Text="{Binding}"
                             TextWrapping="Wrap"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <TabControl x:Name="AgentTabs" Classes="compact-tabs" Grid.Row="1"
                  ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
        <TabControl.Styles>
          <Style Selector="TabControl.compact-tabs TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="28"/>
          </Style>
          <Style Selector="TabControl.compact-tabs TabItem > StackPanel > Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="3,0"/>
          </Style>
        </TabControl.Styles>
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AgentTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
              <!-- W4.4: unread-steering badge - pushed by the session's child-event
                   stream (deliver raises, drain/settle clear), never polled. -->
              <Border CornerRadius="8" Padding="5,0" Background="#4C8CFF"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Badge.HasUnread}">
                <TextBlock Text="{Binding Badge.UnreadCount}" FontSize="10"
                           Foreground="White"/>
              </Border>
              <!-- Issue #312 D6: the parked-chain badge. A chain waiting for a human is the one
                   thing in this application that needs attention, so it cannot depend on the user
                   having opened the rail - the tab header is visible whenever the tab is. Amber
                   rather than the unread badge's blue: waiting-for-you is not unread-mail. -->
              <Border CornerRadius="8" Padding="5,0" Background="#FFB454"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasParkedChains}"
                      ToolTip.Tip="Chains waiting for you: open the Chains view in the workbench">
                <TextBlock Text="{Binding ParkedChains}" FontSize="10"
                           Foreground="#1B1B2F"/>
              </Border>
              <Button Content="✕" Padding="3,0" Background="Transparent" BorderThickness="0"
                      Click="OnCloseTab" ToolTip.Tip="{Binding Subtitle}"/>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <!-- Content is keep-alive in the panel below; the tab control renders
             the header strip only. -->
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Panel/>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>

      <ItemsControl x:Name="KeepAliveHost" Grid.Row="2" ItemsSource="{Binding Tabs}"
                    Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Panel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AgentTabViewModel">
            <!-- The wrapper owns the visibility binding (it reads the tab VM); the tab
                 view's own DataContext switch must not re-scope it.
                 Issue #307 D1: a tab renders the AGENT GRID plus the workbench rail, not one
                 chat. The tab view binds the tab itself, because the grid and the rail are
                 both the tab's - the cells inside it bind their own sessions. -->
            <Panel IsVisible="{Binding IsSelected}">
              <views:WorkspaceTabView DataContext="{Binding}"/>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Empty shell: shown when no tab is open. -->
      <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" Spacing="10"
                  IsVisible="{Binding !HasTabs}">
        <TextBlock
            Text="No agent is open.&#x0a;'Open Workspace' chooses the directory the agent works from."
            TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65" FontSize="15"/>
        <TextBlock
            Text="No API key configured yet — open ⚙ Settings to add one."
            TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85" FontSize="14"
            IsVisible="{Binding !HasConfiguredProvider}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
