<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:eThangAgent.Desktop.Views"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.MainWindow"
        Title="eThang Agent" Width="1000" Height="700"
        Closed="OnWindowClosed">
  <Grid ColumnDefinitions="Auto,*">

    <!-- Left-hand side menu bar: 'Open Agent' plus the bottom-anchored settings entry. -->
    <Border Grid.Column="0" Background="#FF1B1B2F" Width="190">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="eThang Agent" FontWeight="Bold" FontSize="16"
                   Margin="12,14,12,10"/>
        <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Content="⚙ Settings"
                HorizontalAlignment="Stretch" Margin="8,4" Padding="10,6"
                Command="{Binding OpenSettingsCommand}"/>
        <Button x:Name="OpenAgentButton" Content="Open Agent"
                HorizontalAlignment="Stretch" Margin="8,4" Padding="10,6"
                Command="{Binding OpenAgentCommand}"/>
        <Button x:Name="ModelButton" Content="Model"
                HorizontalAlignment="Stretch" Margin="8,4" Padding="10,6"
                Command="{Binding ChooseModelCommand}"
                IsVisible="{Binding HasSelectedTab}"
                ToolTip.Tip="Choose the model for the selected agent"/>
        <!-- Future menu entries append below 'Model'. -->
      </DockPanel>
    </Border>

    <!-- Tab host: one tab per open agent, each hosting its own AgentView. -->
    <Grid Grid.Column="1">
      <Panel>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Spacing="10"
                    IsVisible="{Binding !HasTabs}">
          <TextBlock
              Text="No agent is open.&#x0a;'Open Agent' chooses the directory the agent works from."
              TextWrapping="Wrap" TextAlignment="Center" Opacity="0.65" FontSize="15"/>
          <TextBlock
              Text="No API key configured yet — click ⚙ Settings to add one."
              TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85" FontSize="14"
              IsVisible="{Binding !HasConfiguredProvider}"/>
        </StackPanel>
        <TabControl x:Name="AgentTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                <Button Content="✕" Padding="4,0" Background="Transparent" BorderThickness="0"
                        Click="OnCloseTab" ToolTip.Tip="{Binding Subtitle}"/>
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <views:AgentView DataContext="{Binding ViewModel}"/>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </Panel>
    </Grid>
  </Grid>
</Window>
