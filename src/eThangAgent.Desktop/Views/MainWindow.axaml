<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:eThangAgent.Desktop.Views"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.MainWindow"
        Title="eThang Agent" Width="1000" Height="700"
        Closed="OnWindowClosed">
  <Grid ColumnDefinitions="Auto,*">

    <!-- Left-hand side menu bar. One button today; more menu actions land here later. -->
    <Border Grid.Column="0" Background="#FF1B1B2F" Width="190">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="eThang Agent" FontWeight="Bold" FontSize="16"
                   Margin="12,14,12,10"/>
        <Button x:Name="OpenAgentButton" Content="Open Agent"
                HorizontalAlignment="Stretch" Margin="8,4" Padding="10,6"
                Command="{Binding OpenAgentCommand}"/>
        <!-- Future menu entries append below 'Open Agent'. -->
      </DockPanel>
    </Border>

    <!-- Tab host: one tab per open agent, each hosting its own AgentView. -->
    <Grid Grid.Column="1">
      <Panel>
        <TextBlock x:Name="EmptyState"
                   Text="No agent is open.&#x0a;'Open Agent' chooses the directory the agent works from."
                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.65" FontSize="15"
                   IsVisible="{Binding !HasTabs}"/>
        <TabControl x:Name="AgentTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                <Button Content="✕" Padding="4,0" Background="Transparent" BorderThickness="0"
                        Click="OnCloseTab" ToolTip.Tip="{Binding Subtitle}"/>
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate>
              <views:AgentView DataContext="{Binding ViewModel}"/>
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </Panel>
    </Grid>
  </Grid>
</Window>
