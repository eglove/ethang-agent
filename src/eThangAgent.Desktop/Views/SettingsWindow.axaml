<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="480" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">

    <TextBlock Text="API Keys" FontWeight="Bold" FontSize="14"/>

    <TextBlock Text="OpenRouter" FontWeight="Bold"/>
    <TextBox Text="{Binding OpenRouterKey}" PasswordChar="{Binding KeyPasswordChar}"
             Watermark="No OpenRouter API key configured"/>

    <TextBlock Text="z.ai" FontWeight="Bold" Margin="0,8,0,0"/>
    <TextBox Text="{Binding ZaiKey}" PasswordChar="{Binding KeyPasswordChar}"
             Watermark="No z.ai API key configured"/>

    <CheckBox Content="Show keys" IsChecked="{Binding KeysVisible}" Margin="0,4,0,0"/>

    <TextBlock Text="Keys are stored encrypted on this machine (Windows DPAPI) and apply to newly opened agents. Leave a field blank to remove that key."
               Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>

    <TextBlock Text="{Binding ValidationError}" Foreground="OrangeRed" TextWrapping="Wrap"
               FontSize="12" IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel"/>
      <Button Content="Save" Command="{Binding SaveCommand}"/>
    </StackPanel>
  </StackPanel>
</Window>
