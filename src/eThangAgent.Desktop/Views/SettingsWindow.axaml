<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="480" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <!-- Shared footer: validation error plus Save/Cancel, outside the tabs so it
         applies to whichever category is showing. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,20" Spacing="8">
      <TextBlock x:Name="ValidationErrorText" Text="{Binding ValidationError}"
                 Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
        <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </StackPanel>

    <TabControl x:Name="SettingsTabs" Margin="24,16,24,8">
      <TabItem Header="API Keys">
        <StackPanel Spacing="10">
          <TextBlock Text="OpenRouter" FontWeight="Bold"/>
          <TextBox x:Name="OpenRouterKeyBox" Text="{Binding OpenRouterKey}"
                   PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="No OpenRouter API key configured"/>
          <TextBlock Text="z.ai" FontWeight="Bold" Margin="0,6,0,0"/>
          <TextBox x:Name="ZaiKeyBox" Text="{Binding ZaiKey}" PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="No z.ai API key configured"/>
          <TextBlock Text="Local (OpenAI-compatible)" FontWeight="Bold" Margin="0,6,0,0"/>
          <TextBox x:Name="LocalBaseUrlBox" Text="{Binding LocalBaseUrlText}"
                   PlaceholderText="http://localhost:1234"/>
          <TextBox x:Name="LocalKeyBox" Text="{Binding LocalApiKey}" PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="No local API key configured"/>
          <CheckBox x:Name="ShowKeysCheck" Content="Show keys" IsChecked="{Binding KeysVisible}" Margin="0,4,0,0"/>
          <TextBlock
              Text="Keys are stored encrypted on this machine (Windows DPAPI) and apply to newly opened agents. Leave a field blank to remove that key. The local server address is stored as typed (it is not a secret); a blank base URL removes the Local provider."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Files">
        <StackPanel Spacing="10">
          <TextBlock Text="Global session files (loaded for every workspace)" FontWeight="Bold"/>
          <ItemsControl x:Name="GlobalFilesList" ItemsSource="{Binding GlobalFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox IsChecked="{Binding Enabled}"/>
                  <TextBlock Text="{Binding Path}" VerticalAlignment="Center"/>
                  <Button Content="✕" Command="{Binding $parent[ItemsControl].DataContext.RemoveGlobalFileCommand}"
                          CommandParameter="{Binding}" Padding="2,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="NewGlobalFileBox" Text="{Binding NewGlobalFile}" Width="320"
                     PlaceholderText="C:\absolute\path\to\file.md"/>
            <Button x:Name="AddGlobalFileButton" Content="Add" Command="{Binding AddGlobalFileCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding InfoMessage}" Foreground="Goldenrod" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding InfoMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <TextBlock x:Name="WorkspaceRootText"
                   Text="{Binding WorkspaceRoot}"
                   FontWeight="Bold" Margin="0,6,0,0"
                   IsVisible="{Binding HasWorkspace}"/>
          <TextBlock Text="Workspace session files (loaded for the workspace above only)"
                   FontWeight="Bold" IsVisible="{Binding HasWorkspace}"/>
          <ItemsControl x:Name="WorkspaceFilesList" ItemsSource="{Binding WorkspaceFiles}" IsVisible="{Binding HasWorkspace}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox IsChecked="{Binding Enabled}"/>
                  <TextBlock Text="{Binding Path}" VerticalAlignment="Center"/>
                  <Button Content="✕" Command="{Binding $parent[ItemsControl].DataContext.RemoveWorkspaceFileCommand}"
                          CommandParameter="{Binding}" Padding="2,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasWorkspace}">
            <TextBox x:Name="NewWorkspaceFileBox" Text="{Binding NewWorkspaceFile}" Width="320"
                     PlaceholderText="C:\absolute\path\to\file.md"/>
            <Button x:Name="AddWorkspaceFileButton" Content="Add" Command="{Binding AddWorkspaceFileCommand}"/>
          </StackPanel>
          <TextBlock
              Text="Checked files are read at session start and injected verbatim into the system prompt (global first, then workspace). Missing or unreadable files are skipped with a note; nothing is loaded unless you configure it here. Applies to newly opened agents."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Models">
        <StackPanel Spacing="10">
          <TextBlock Text="z.ai endpoint" FontWeight="Bold"/>
          <ComboBox x:Name="ZaiEndpointBox" ItemsSource="{Binding EndpointModes}" SelectedItem="{Binding SelectedEndpointMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Coding plan (subscription) keys work only on the coding endpoint — against the general endpoint they are rejected as rate-limited. The z.ai capability tools (web search, reader, tokenizer, image, OCR, transcription) exist only on the general endpoint."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="Compaction model" FontWeight="Bold" Margin="0,6,0,0"/>
          <ComboBox x:Name="CompactionModelBox" ItemsSource="{Binding CompactionModels}" SelectedItem="{Binding SelectedCompactionModel}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Writes the handoff summary when a conversation is auto-compacted at 80% context. Automatic picks the cheapest capable model at compaction time; applies from the next compaction."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Git">
        <StackPanel Spacing="10">
          <TextBlock Text="Commit style" FontWeight="Bold"/>
          <ComboBox x:Name="CommitStyleBox" ItemsSource="{Binding CommitStyles}" SelectedItem="{Binding SelectedCommitStyle}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Applies to newly opened agents and to the next commit in open ones. Conventional uses type/scope, Gitmoji an emoji key, Plain a bare description."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
