<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="760" Height="720"
        MinWidth="560" MinHeight="420"
        CanResize="True" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <!-- Shared footer: validation error plus Save/Cancel, outside the tabs so it
         applies to whichever category is showing. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,20" Spacing="8">
      <TextBlock x:Name="ValidationErrorText" Text="{Binding ValidationError}"
                 Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
        <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </StackPanel>

    <TabControl x:Name="SettingsTabs" Margin="24,16,24,8">
      <TabItem Header="API Keys">
        <StackPanel Spacing="10">
          <TextBlock Text="OpenRouter" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="SignInStatusText" Text="{Binding SignInStatus}"
                       VerticalAlignment="Center"/>
            <Button x:Name="SignInButton" Content="{Binding SignInLabel}"
                    Command="{Binding SignInCommand}"
                    IsVisible="{Binding ShowsSignInButton}"/>
            <Button x:Name="SignOutButton" Content="Sign out"
                    Command="{Binding SignOutCommand}"
                    IsVisible="{Binding IsSignedIn}"/>
            <Button x:Name="TestOpenRouterButton" Content="{Binding OpenRouterTestLabel}"
                    Command="{Binding TestOpenRouterCommand}"
                    IsVisible="{Binding CanTestOpenRouter}"
                    ToolTip.Tip="Pull this provider's model list with the key above, so a wrong key is caught here rather than on the first turn. Save makes the models appear in the model search."/>
          </StackPanel>
          <TextBlock x:Name="OpenRouterTestResultText" Text="{Binding OpenRouterTestResult}"
                     TextWrapping="Wrap" FontSize="12"
                     IsVisible="{Binding HasOpenRouterTestResult}"/>
          <TextBlock Text="{Binding SignInError}" Foreground="OrangeRed" TextWrapping="Wrap"
                     FontSize="12"
                     IsVisible="{Binding HasSignInError}"/>
          <TextBox x:Name="OpenRouterKeyBox" Text="{Binding OpenRouterKey}"
                   PasswordChar="{Binding KeyPasswordChar}"
                   IsVisible="{Binding ShowsKeyField}"
                   PlaceholderText="Paste an OpenRouter API key"/>
          <TextBlock Text="Management key (optional)" FontWeight="Bold" Margin="0,6,0,0"/>
          <TextBox x:Name="OpenRouterManagementKeyBox" Text="{Binding OpenRouterManagementKey}"
                   PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="No OpenRouter management key configured"/>
          <CheckBox x:Name="ShowKeysCheck" Content="Show keys" IsChecked="{Binding KeysVisible}" Margin="0,4,0,0"/>
          <TextBlock
              Text="Sign in to create a key in your own OpenRouter account. Once a key is configured this page says so and the key field is gone; Sign out clears it, and Save removes the stored key. Keys are stored encrypted on this machine (Windows DPAPI) and apply to newly opened agents. Leave the management key field blank to remove that key. The management key (sk-or-... from openrouter.ai/settings/keys, marked as a management key) unlocks the openrouter_management tool; it never touches model calls."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>

          <Separator Margin="0,8,0,0"/>
          <TextBlock Text="Cloudflare Workers AI" FontWeight="Bold"/>
          <TextBlock x:Name="CloudflareStatusText" Text="{Binding CloudflareStatus}"
                     VerticalAlignment="Center"/>
          <TextBox x:Name="CloudflareAccountIdBox" Text="{Binding CloudflareAccountId}"
                   PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="Cloudflare account id"/>
          <TextBox x:Name="CloudflareApiTokenBox" Text="{Binding CloudflareApiToken}"
                   PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="Cloudflare API token"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TestCloudflareButton" Content="{Binding CloudflareTestLabel}"
                    Command="{Binding TestCloudflareCommand}"
                    IsVisible="{Binding CanTestCloudflare}"
                    ToolTip.Tip="Pull this account's model list with the account id and token above, so a wrong credential is caught here rather than on the first turn. Save makes the models appear in the model search."/>
          </StackPanel>
          <TextBlock x:Name="CloudflareTestResultText" Text="{Binding CloudflareTestResult}"
                     TextWrapping="Wrap" FontSize="12"
                     IsVisible="{Binding HasCloudflareTestResult}"/>
          <TextBlock
              Text="Both fields are needed: Cloudflare models appear in the model search only while an account id and an API token are configured. Test pulls this account's models with what is in the fields, so a wrong credential is caught before it is saved. Saving then makes those models appear in the model search of the agents already open, with no restart. The credential applies to every workspace and is stored encrypted on this machine (Windows DPAPI), exactly like the OpenRouter key. Leave a field blank to remove it; clearing either removes Cloudflare from the model search. The token needs Workers AI read access on that account."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Skills">
        <StackPanel Spacing="10">
          <TextBlock Text="Skill registry" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Default install target" VerticalAlignment="Center"/>
            <ComboBox x:Name="SkillRegistryTargetBox" SelectedIndex="{Binding SkillRegistryTargetIndex}" MinWidth="120">
              <ComboBoxItem Content="Unset (ask every install)"/>
              <ComboBoxItem Content="Global directory"/>
              <ComboBoxItem Content="Workspace directory"/>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="Where skill_registry installs go when the tool call names no target. Applies to newly opened agents." Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>

          <Separator Margin="0,4,0,0"/>
          <TextBlock Text="Session files" FontWeight="Bold" Margin="0,4,0,0"/>
          <TextBlock Text="Every workspace (loaded for every workspace)" Opacity="0.8" FontSize="12"/>
          <ItemsControl x:Name="GlobalSessionFilesList" ItemsSource="{Binding GlobalSessionFiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionFileRow">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox IsChecked="{Binding Enabled}"/>
                  <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="380"
                             ToolTip.Tip="{Binding Path}"/>
                  <Button Content="✕"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveGlobalFileCommand}"
                          CommandParameter="{Binding}" Padding="2,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="PickGlobalFileButton" Content="Add file…"
                  Command="{Binding PickGlobalFileCommand}" HorizontalAlignment="Left"/>
          <TextBlock
              Text="Checked files are read at session start and injected verbatim into the system prompt, before this workspace's own files. Missing or unreadable files are skipped with a note."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>

          <Separator Margin="0,4,0,0"/>
          <TextBlock Text="Skill directories" FontWeight="Bold" Margin="0,4,0,0"/>
          <TextBlock Text="Every workspace (scanned for every workspace)" Opacity="0.8" FontSize="12"/>
          <ItemsControl x:Name="GlobalSkillDirectoriesList" ItemsSource="{Binding GlobalSkillDirectories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionFileRow">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox IsChecked="{Binding Enabled}"/>
                  <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="380"
                             ToolTip.Tip="{Binding Path}"/>
                  <Button Content="✕"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveGlobalSkillDirectoryCommand}"
                          CommandParameter="{Binding}" Padding="2,0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="PickGlobalSkillDirectoryButton" Content="Add directory…"
                  Command="{Binding PickGlobalSkillDirectoryCommand}" HorizontalAlignment="Left"/>
          <TextBlock
              Text="Checked directories are scanned at session start for file skills (agentskills.io SKILL.md folders); a workspace directory equal to a global one is scanned once."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock x:Name="SkillsFileErrorText" Text="{Binding FileError}"
                     Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"
                     IsVisible="{Binding FileError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Language servers">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.75" FontSize="12">
            Every language this app can serve, and which of them this machine has. Nothing is
            installed until you install it, except C#, which ships with the app. A language whose
            toolchain this machine lacks stays listed and says what is missing. Installs land in
            the app's own cache directory, and removing one deletes only that directory.
          </TextBlock>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="LanguageServersLoadingText"
                       Text="{Binding LanguageServersPage.LoadingText}"
                       Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                       IsVisible="{Binding LanguageServersPage.IsLoading}"/>
            <TextBlock x:Name="LanguageServersErrorText"
                       Text="{Binding LanguageServersPage.PageError}" Foreground="OrangeRed"
                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                       IsVisible="{Binding LanguageServersPage.PageError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock x:Name="LanguageServersUnavailableText"
                       Text="This host wired no language-server seams, so there is nothing to install or remove here."
                       Opacity="0.75" FontSize="12" VerticalAlignment="Center"
                       IsVisible="{Binding !HasLanguageServersPage}"/>
            <Button x:Name="RefreshLanguageServersButton" Content="Refresh"
                    Command="{Binding LanguageServersPage.RefreshCommand}"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding HasLanguageServersPage}"/>
          </StackPanel>

          <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="LanguageList" ItemsSource="{Binding LanguageServersPage.Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageServerRowViewModel">
                  <Border BorderBrush="#33808080" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                        <TextBlock FontSize="12" Opacity="0.7" Text="{Binding StatusText}"/>
                        <TextBlock FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                   Text="{Binding StatusDetail}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Center">
                        <Button x:Name="InstallButton" Content="Install"
                                Command="{Binding InstallCommand}"
                                IsVisible="{Binding CanInstall}"/>
                        <Button x:Name="UpdateButton" Content="Update"
                                Command="{Binding UpdateCommand}"
                                IsVisible="{Binding CanUpdate}"/>
                        <Button x:Name="RemoveButton" Content="Remove"
                                Command="{Binding RemoveCommand}"
                                IsVisible="{Binding CanRemove}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Tools">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.75" FontSize="12">
            Which of this machine's console programs and scripts agents are told about. Nothing is
            ticked until you tick it, so a fresh install tells agents about no tools at all.
            Ticked tools are named to every agent this app opens; a ticked tool that is no longer
            on the PATH is kept, shown as unavailable, and left out of what agents are told.
            Changes apply from the next app launch.
          </TextBlock>

          <StackPanel Grid.Row="1" x:Name="ToolsPagePanel" Spacing="6"
                      IsVisible="{Binding HasToolsPage}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" x:Name="ToolsSearchBox"
                       Text="{Binding ToolsPage.SearchText}"
                       PlaceholderText="Filter by name"/>
              <Button Grid.Column="1" x:Name="ToolsRescanButton" Content="Rescan"
                      Command="{Binding ToolsPage.LoadCommand}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" x:Name="ToolsAddNameBox"
                       Text="{Binding ToolsPage.NameToAdd}"
                       PlaceholderText="Add a tool name that is not on the PATH"/>
              <Button Grid.Column="1" x:Name="ToolsAddNameButton" Content="Add"
                      Command="{Binding ToolsPage.AddNameCommand}"/>
            </Grid>
            <TextBlock x:Name="ToolsSummaryText" Text="{Binding ToolsPage.SummaryText}"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="ToolsLoadingText" Text="Reading the PATH..." Opacity="0.7"
                       FontSize="12" IsVisible="{Binding ToolsPage.IsLoading}"/>
            <TextBlock x:Name="ToolsStatusText" Text="{Binding ToolsPage.StatusText}" Opacity="0.7"
                       TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding ToolsPage.StatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          </StackPanel>

          <TextBlock Grid.Row="1" x:Name="ToolsUnavailableText"
                     Text="This host keeps no app preferences, so a tool selection could not be saved here."
                     Opacity="0.75" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top"
                     IsVisible="{Binding !HasToolsPage}"/>

          <ScrollViewer Grid.Row="2">
            <ItemsControl x:Name="ToolsGroupList" ItemsSource="{Binding ToolsPage.Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolGroupViewModel">
                  <Border BorderBrush="#33808080" BorderThickness="0,0,0,1" Padding="0,6">
                    <Expander IsExpanded="{Binding IsExpanded}">
                      <Expander.Header>
                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ToolRowViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                              <CheckBox Grid.Column="0" IsChecked="{Binding IsTicked}"/>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AvailabilityText}" FontSize="12"
                                           Opacity="0.6" VerticalAlignment="Center"
                                           IsVisible="{Binding IsUnavailable}"/>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Models">
        <StackPanel Spacing="10">
          <TextBlock Text="Compaction model" FontWeight="Bold"/>
          <ComboBox x:Name="CompactionModelBox" ItemsSource="{Binding CompactionModels}" SelectedItem="{Binding SelectedCompactionModel}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Writes the handoff summary when a conversation is auto-compacted at 80% context. Automatic picks the cheapest capable model at compaction time; applies from the next compaction."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Agents">
        <StackPanel Spacing="10">
          <TextBlock Text="Max concurrent agents" FontWeight="Bold"/>
          <TextBox x:Name="MaxConcurrentAgentsBox" Text="{Binding MaxConcurrentAgentsText}"
                   PlaceholderText="4"/>
          <TextBlock Text="Default sub-agent model" FontWeight="Bold" Margin="0,6,0,0"/>
          <TextBox x:Name="DefaultModelBox" Text="{Binding DefaultModelText}"
                   PlaceholderText="No default — spawns pass a model explicitly"/>
          <CheckBox x:Name="ComputerUseCheck" Content="Enable computer use (desktop automation tool)"
                    IsChecked="{Binding ComputerUse}" Margin="0,4,0,0"
                    ToolTip.Tip="Adds the 'computer' tool to newly opened agents. Applies to sessions opened from now on."/>
          <CheckBox x:Name="CompactionHandoffCheck" Content="Hand off to a new session instead of compacting in place"
                    IsChecked="{Binding CompactionHandoff}" Margin="0,4,0,0"
                    ToolTip.Tip="At the compaction ceiling the conversation ends and continues in a NEW session seeded with the summary. The old session stays resumable. Off by default."/>
          <TextBlock Text="Root turn budget" FontWeight="Bold" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="RootTurnIdleBox" Text="{Binding RootTurnIdleText}" Width="140"
                     PlaceholderText="blank = 00:02:00"/>
            <TextBlock Text="Idle bound" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>

          <TextBlock Text="Watchdog" FontWeight="Bold" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WatchdogTickBox" Text="{Binding WatchdogTickText}" Width="140"
                     PlaceholderText="blank = 00:01:00"/>
            <TextBlock Text="Tick interval" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WatchdogIdleBox" Text="{Binding WatchdogIdleText}" Width="140"
                     PlaceholderText="blank = 00:15:00"/>
            <TextBlock Text="Idle threshold" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WatchdogWrapUpBox" Text="{Binding WatchdogWrapUpText}" Width="140"
                     PlaceholderText="blank = 1"/>
            <TextBlock Text="Max wrap-up attempts" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
          <TextBlock
              Text="The watchdog restarts a child agent that stops making progress: it samples each running child's activity every tick interval, and a child idle past the threshold is cancelled and restarted once with a wrap-up nudge (its partial work is kept); a second idle breach marks it failed. Max wrap-up attempts is how many of those nudged restarts a child may receive. Durations use constant format — '00:01:00' is one minute; a bare number is rejected (it would read as days). Blank fields keep the defaults. The child host applies changes to newly opened agents; the app-side watchdog binds them once per process — changes reach it after the app restarts."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Advanced">
        <StackPanel Spacing="10">
          <TextBlock Text="OpenRouter base URL" FontWeight="Bold"/>
          <TextBox x:Name="OpenRouterBaseUrlBox" Text="{Binding OpenRouterBaseUrlText}"
                   PlaceholderText="https://openrouter.ai (provider default)"/>
          <TextBlock
              Text="Overrides the provider API root — for gateways or proxies that mirror the provider's API. Leave the field blank to use the provider default. The stored address is not a secret and applies to newly opened agents."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Git">
        <StackPanel Spacing="10">
          <TextBlock Text="Commit style" FontWeight="Bold"/>
          <ComboBox x:Name="CommitStyleBox" ItemsSource="{Binding CommitStyles}" SelectedItem="{Binding SelectedCommitStyle}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Applies to newly opened agents and to the next commit in open ones. Conventional uses type/scope, Gitmoji an emoji key, Plain a bare description."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
