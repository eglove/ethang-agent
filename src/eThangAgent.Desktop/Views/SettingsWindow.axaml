<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="480" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <!-- Shared footer: validation error plus Save/Cancel, outside the tabs so it
         applies to whichever category is showing. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,20" Spacing="8">
      <TextBlock x:Name="ValidationErrorText" Text="{Binding ValidationError}"
                 Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding ValidationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
        <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </StackPanel>

    <TabControl x:Name="SettingsTabs" Margin="24,16,24,8">
      <TabItem Header="API Keys">
        <StackPanel Spacing="10">
          <TextBlock Text="OpenRouter" FontWeight="Bold"/>
          <TextBox x:Name="OpenRouterKeyBox" Text="{Binding OpenRouterKey}"
                   PasswordChar="{Binding KeyPasswordChar}"
                   PlaceholderText="No OpenRouter API key configured"/>
          <CheckBox x:Name="ShowKeysCheck" Content="Show keys" IsChecked="{Binding KeysVisible}" Margin="0,4,0,0"/>
          <TextBlock
              Text="Keys are stored encrypted on this machine (Windows DPAPI) and apply to newly opened agents. Leave the field blank to remove the key."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Skills">
        <StackPanel Spacing="10">
          <TextBlock Text="Skill registry" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Default install target" VerticalAlignment="Center"/>
            <ComboBox x:Name="SkillRegistryTargetBox" SelectedIndex="{Binding SkillRegistryTargetIndex}" MinWidth="120">
              <ComboBoxItem Content="Unset (ask every install)"/>
              <ComboBoxItem Content="Global directory"/>
              <ComboBoxItem Content="Workspace directory"/>
            </ComboBox>
          </StackPanel>
          <TextBlock Text="Where skill_registry installs go when the tool call names no target. Applies to newly opened agents." Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock
              Text="Session files and skill directories are configured in the Open Workspace dialog when a workspace is opened."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Models">
        <StackPanel Spacing="10">
          <TextBlock Text="Compaction model" FontWeight="Bold"/>
          <ComboBox x:Name="CompactionModelBox" ItemsSource="{Binding CompactionModels}" SelectedItem="{Binding SelectedCompactionModel}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Writes the handoff summary when a conversation is auto-compacted at 80% context. Automatic picks the cheapest capable model at compaction time; applies from the next compaction."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Agents">
        <StackPanel Spacing="10">
          <TextBlock Text="Max concurrent agents" FontWeight="Bold"/>
          <TextBox x:Name="MaxConcurrentAgentsBox" Text="{Binding MaxConcurrentAgentsText}"
                   PlaceholderText="4"/>
          <TextBlock Text="Default sub-agent model" FontWeight="Bold" Margin="0,6,0,0"/>
          <TextBox x:Name="DefaultModelBox" Text="{Binding DefaultModelText}"
                   PlaceholderText="No default — spawns pass a model explicitly"/>
          <CheckBox x:Name="RemoteHostCheck" Content="Run child agents in an out-of-process host"
                    IsChecked="{Binding RemoteHost}" Margin="0,4,0,0"/>
          <CheckBox x:Name="ComputerUseCheck" Content="Enable computer use (desktop automation tool)"
                    IsChecked="{Binding ComputerUse}" Margin="0,4,0,0"
                    ToolTip.Tip="Adds the 'computer' tool to newly opened agents. Applies to sessions opened from now on."/>
          <TextBlock Text="Watchdog" FontWeight="Bold" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WatchdogTickBox" Text="{Binding WatchdogTickText}" Width="140"
                     PlaceholderText="blank = 00:01:00"/>
            <TextBlock Text="Tick interval" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WatchdogIdleBox" Text="{Binding WatchdogIdleText}" Width="140"
                     PlaceholderText="blank = 00:15:00"/>
            <TextBlock Text="Idle threshold" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox x:Name="WatchdogWrapUpBox" Text="{Binding WatchdogWrapUpText}" Width="140"
                     PlaceholderText="blank = 1"/>
            <TextBlock Text="Max wrap-up attempts" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
          <TextBlock
              Text="The watchdog restarts a child agent that stops making progress: it samples each running child's activity every tick interval, and a child idle past the threshold is cancelled and restarted once with a wrap-up nudge (its partial work is kept); a second idle breach marks it failed. Max wrap-up attempts is how many of those nudged restarts a child may receive. Durations use constant format — '00:01:00' is one minute; a bare number is rejected (it would read as days). Blank fields keep the defaults. The child host applies changes to newly opened agents; the app-side watchdog binds them once per process — changes reach it after the app restarts."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Advanced">
        <StackPanel Spacing="10">
          <TextBlock Text="OpenRouter base URL" FontWeight="Bold"/>
          <TextBox x:Name="OpenRouterBaseUrlBox" Text="{Binding OpenRouterBaseUrlText}"
                   PlaceholderText="https://openrouter.ai (provider default)"/>
          <TextBlock
              Text="Overrides the provider API root — for gateways or proxies that mirror the provider's API. Leave the field blank to use the provider default. The stored address is not a secret and applies to newly opened agents."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Git">
        <StackPanel Spacing="10">
          <TextBlock Text="Commit style" FontWeight="Bold"/>
          <ComboBox x:Name="CommitStyleBox" ItemsSource="{Binding CommitStyles}" SelectedItem="{Binding SelectedCommitStyle}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock
              Text="Applies to newly opened agents and to the next commit in open ones. Conventional uses type/scope, Gitmoji an emoji key, Plain a bare description."
              Opacity="0.6" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
