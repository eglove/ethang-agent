<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:eThangAgent.Desktop.ViewModels"
        x:Class="eThangAgent.Desktop.Views.EffortPickerWindow"
        x:DataType="vm:EffortPickerViewModel"
        Title="Choose Reasoning Effort" Width="420" Height="520" MinWidth="360" MinHeight="300"
        CanResize="True" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="16">

    <ListBox Grid.Row="0" x:Name="EffortList" ItemsSource="{Binding Rows}"
             SelectedItem="{Binding SelectedRow}" DoubleTapped="OnRowDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EffortPickerRow">
          <StackPanel Margin="2,4">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                Margin="0,8,0,0">
      <Button Content="Cancel" Click="OnCancel"/>
      <Button x:Name="SelectButton" Content="Select" Command="{Binding ConfirmCommand}"/>
    </StackPanel>
  </Grid>
</Window>
