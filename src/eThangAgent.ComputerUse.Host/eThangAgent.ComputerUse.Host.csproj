<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- M10: LibraryImport's source generator emits unsafe code (ours contains none);
         this flag exists solely so the generator output compiles. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The broker's dispatch seam is unit-tested directly (pipe-less tests);
         internals are exposed to the test assembly like the Desktop's surface. -->
    <InternalsVisibleTo Include="eThangAgent.ComputerUse.Host.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The broker is an APP of its own, and a REFERENCING app publishes the referenced
         assemblies but NOT its deps.json (the SDK treats that file as app-local
         metadata for the referencing app). Without its manifest the broker cannot
         resolve its own native assets - the same gap that made the conversation host
         fail every root turn in a published app (2026-10-22). The file is already in
         the output folder (the SDK writes it there); this makes the PUBLISH carry it. -->
    <Content Include="$(TargetDir)$(ProjectDepsFileName)"
             Condition="'$(GenerateDependencyFile)' == 'true'"
             Link="$(ProjectDepsFileName)"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../eThangAgent.SharedKernel/eThangAgent.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- R1 (task 18): the element-op dispatcher runs REAL UIA patterns through
         System.Windows.Automation (UIAutomationClient ships in the desktop WPF profile). -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
</Project>
