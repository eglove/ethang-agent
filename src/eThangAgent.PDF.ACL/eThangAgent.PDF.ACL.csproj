<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../eThangAgent.Tool.Domain/eThangAgent.Tool.Domain.csproj" />
    <ProjectReference Include="../eThangAgent.SharedKernel/eThangAgent.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <PackageReference Include="PDFtoImage" Version="4.*" />
    <PackageReference Include="QuestPDF" Version="2024.*" />
    <!-- PDFsharp 6.x core flavor. No font-resolver add-on package is required: the
         core build's built-in WindowsPlatformFontResolver resolves standard faces
         (Arial/Times) from C:\Windows\Fonts once GlobalFontSettings
         .UseWindowsFontsUnderWindows is set (PdfManipulator's static ctor does this). -->
    <PackageReference Include="PDFsharp" Version="6.*" />
  </ItemGroup>
</Project>
