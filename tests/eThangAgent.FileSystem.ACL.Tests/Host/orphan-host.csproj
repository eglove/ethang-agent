<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- The orphan sweep's crash test writes one image through the REAL store and then exits
         with nothing naming it. It is a separate executable because the write and the kill have
         to happen in two processes: a process that cannot be killed cannot reproduce a crash.
         It lives under tests/ so it inherits the repo's warning policy, and it undoes the two
         test-runner inheritances that would otherwise give it a generated entry point: the
         suite marks everything under tests/ a test project, whose xunit targets emit their own
         Main and whose linked registration file needs the xunit package. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <AssemblyName>ethang-orphan-host</AssemblyName>
    <RootNamespace>eThangAgent.OrphanHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Remove="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Remove="xunit.analyzers" />
    <!-- The suite's framework registration is linked in by tests/Directory.Build.props and is
         meaningless here (this program runs no tests). Removed by the name it is linked under.
         -->
    <Compile Remove="TestFrameworkRegistration.cs" />
    <ProjectReference Remove="../eThangAgent.TestSupport/eThangAgent.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/eThangAgent.FileSystem.ACL/eThangAgent.FileSystem.ACL.csproj" />
  </ItemGroup>
</Project>
