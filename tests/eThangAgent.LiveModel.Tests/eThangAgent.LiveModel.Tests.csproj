<Project Sdk="Microsoft.NET.Sdk">
  <!-- The LIVE-MODEL suite (issue #289): the one test project that drives the real
       composition against a REAL free model over the real provider wire. Every other
       suite uses fake providers, which is right - a fake is written by the same person
       who wrote the code under test - but leaves the wire, the tool round trip, and the
       transcript's losslessness unexercised against a provider that was not written here.
       <para>ISOLATION: the tests carry [Trait("Category", "LiveModel")], so a plain
       `dotnet test` over the solution runs them and they SKIP (xunit's runtime
       Assert.Skip) when no key is configured - an offline machine stays offline, and a
       fork's PR never fails on a missing secret. CI runs them in the separate,
       non-required `live-model` job.</para> -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/eThangAgent.Composition/eThangAgent.Composition.csproj" />
    <ProjectReference Include="../../src/eThangAgent.Model.Domain/eThangAgent.Model.Domain.csproj" />
    <ProjectReference Include="../../src/eThangAgent.Storage.ACL/eThangAgent.Storage.ACL.csproj" />
    <!-- The ChildHost leak guard (issue #284 item 3): an assembly fixture that fails the
         run, naming the pids, when a host outlives the tests - and every test here opens a
         real session, which OWNS a real host process. -->
    <ProjectReference Include="../eThangAgent.Tests.Shared/eThangAgent.Tests.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The stored Tier-2 baseline: read from the test's own output directory, so it rides the
         build like the prompts file SkillActivationEval copies. A first run with no baseline
         records one instead of comparing; drops are REPORTED, never failed. -->
    <Content Include="tier2-baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
