<Project>
  <!-- Chain to the repo-root props so warning/analyzer policy has one source of
       truth (TFM, Nullable, TreatWarningsAsErrors are inherited, not duplicated);
       then layer test-only settings and overrides below. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', $(MSBuildThisFileDirectory)..))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- MTP test applications are executables; xunit.v3's targets require Exe
         (Microsoft.NET.Test.Sdk used to set this, and is deliberately absent). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- xunit.v3 runs on Microsoft.Testing.Platform; the MTP mode of dotnet test
       is enabled globally via the test section in global.json. The whole MTP
       family must stay generation-aligned: xunit.v3 3.2.x bridges through MTP
       1.9.1, so the extensions below are 1.9.x / 17.12.x (the MTP-1.x
       generation). Microsoft.NET.Test.Sdk is deliberately absent - it pins MTP
       2.3.x, which breaks the 3.2.x bridge (TypeLoadException at startup).
       xunit.runner.visualstudio and coverlet.collector are VSTest-only
       extensions (dead weight under MTP) and are also absent.
       Follow-up: Avalonia.Headless.XUnit 12.1.6 is compiled against the
       xunit.v3 3.2.2 API; xunit.v3 4.x is binary-incompatible with it
       (MissingMethodException during discovery). Bump xunit.v3 to 4.x only
       together with an Avalonia release that supports it, and move the MTP
       extensions to the matching generation in the same change. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.12.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="1.9.*" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" Version="3.2.*" />
    <!-- xunit.analyzers is pinned explicitly: xunit.v3 3.2.x pulls it transitively
         (>= 1.27.0), so the rules already ran via the repo-wide error escalation —
         the pin exists to take 2.3.0's rule set now, ahead of the xunit.v3 4.x
         bump (which requires >= 2.0.0, so this pin introduces no version conflict).
         Analyzer-only: never a runtime dependency. -->
    <PackageReference Include="xunit.analyzers" Version="2.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Issue #378: the ceiling rule is enforced by a Roslyn analyzer, not by a regex over
         source text. An analyzer reads the semantic model, so it catches the SHAPE of a
         load-sensitive wait - a deadline variable, a raced delay, a cancellation timeout, a
         fixed sleep - instead of one spelling of it, and it reaches the helpers where the
         suite actually waits. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/eThangAgent.Analyzers/eThangAgent.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- EVERY TEST RUNS UNDER THE CEILING (issue: a hung test must fail, not stall the run).
       The registration is linked in rather than copied per project, and the support reference
       is added here rather than in each csproj, so a new test project inherits both by being
       under tests/ - it cannot join the suite without the bound. Analyzers.Tests is the one
       project that did not already reference TestSupport; its own csproj keeps its analyzer
       reference, and this adds only what the registration needs. -->
  <!-- Only projects that actually RUN tests get the registration: the support libraries under
       tests/ are libraries, and an assembly-level attribute there would be meaningless. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)TestFrameworkRegistration.cs" Link="TestFrameworkRegistration.cs" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)eThangAgent.TestSupport/eThangAgent.TestSupport.csproj" />
  </ItemGroup>

  <!-- Test assemblies use the xUnit Method_Scenario_Expected naming convention,
       which requires underscores. CA1707 stays enforced in src/; here it is
       deliberately suppressed (named decision, not blanket leniency). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
